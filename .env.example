# Discord Bot Token - получить на https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID бота (находится в General Information)
CLIENT_ID=your_client_id_here

# ID вашего Discord сервера (гильдии) - опционально для быстрой регистрации команд
GUILD_ID=your_guild_id_here

# Порт для веб-сервера
PORT=3001

# URL фронтенда (для CORS)
FRONTEND_URL=http://localhost:5173
